# DOCINTEL AI - Backend Environment Configuration

# Database
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=docintel

# Security & Authentication
JWT_SECRET=docintel-super-secret-jwt-key-production-ready-2025
JWT_EXPIRE_MINUTES=60
ALGORITHM=HS256

# OCR Engine
# On Windows, commonly: C:\Program Files\Tesseract-OCR\tesseract.exe
# On Linux / Docker: /usr/bin/tesseract
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# AI Models
HF_MODEL_NAME=Jean-Baptiste/roberta-large-ner-english
EMBEDDING_MODEL=all-MiniLM-L6-v2

# RAG & LLM
LLM_PROVIDER=local
LLM_API_KEY=

# CORS & Networking
FRONTEND_URL=http://localhost:5173
PORT=8000
HOST=0.0.0.0
