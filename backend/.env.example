# DOCINTEL AI - Backend Environment Configuration

# Runtime environment: development | staging | production
# In production the app refuses to start with insecure JWT/CORS/fallback settings.
ENVIRONMENT=development

# Database
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=docintel
# Set to false in staging/production. Forced off in production.
ALLOW_LOCAL_FALLBACK=true

# Security & Authentication
# REQUIRED in production: a strong, unique secret of at least 32 characters.
# Generate one, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-strong-random-secret-at-least-32-chars
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256

# One-time admin bootstrap (environment driven). Leave blank outside first deploy.
# In production the password must be at least 12 characters.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# OCR Engine
# On Windows, commonly: C:\Program Files\Tesseract-OCR\tesseract.exe
# On Linux / Docker: /usr/bin/tesseract
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# AI Models
HF_MODEL_NAME=Jean-Baptiste/roberta-large-ner-english
EMBEDDING_MODEL=all-MiniLM-L6-v2

# RAG & LLM
LLM_PROVIDER=local
LLM_API_KEY=

# CORS & Networking
# Comma-separated allow-list. The wildcard "*" is not permitted in production.
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=8000
HOST=0.0.0.0

# Upload limits
MAX_UPLOAD_SIZE_MB=15
MAX_SEARCH_QUERY_LENGTH=200

# ---------------------------------------------------------------------------
# Phase 2 — Asynchronous processing (Redis + Celery)
# ---------------------------------------------------------------------------
# Message broker / result backend. Never hard-code production credentials.
REDIS_URL=redis://localhost:6379/0
# "local"  -> process in-process background task (no Redis required; default)
# "celery" -> dispatch to Celery workers (required in Docker/production)
PROCESSING_QUEUE=local
# Bounded retry policy for transient failures (exponential backoff, seconds).
MAX_PROCESSING_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=30,60,120
# Hard time limit (seconds) for a single processing task.
PROCESSING_TASK_TIME_LIMIT=1800

# ---------------------------------------------------------------------------
# Phase 2 — Object storage
# ---------------------------------------------------------------------------
# "local" -> filesystem; "s3" -> S3-compatible object storage (future phase).
STORAGE_BACKEND=local
# Optional override for the local storage root (defaults to backend/uploads).
STORAGE_LOCAL_ROOT=
# Only required when STORAGE_BACKEND=s3 (not needed for local development).
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
